# Copy this file to .env, fill the values, and upload .env alongside app.py.
# Do not commit or share the filled .env file.

# Telegram (required to run the bot)
BOT_TOKEN=
BOT_USERNAME=
ADMIN_IDS=

# Database (required). Obtain the full PostgreSQL connection URL in the DB panel.
# Example: postgresql://db_user:db_password@87.106.100.187:6687/db_name
DATABASE_URL=

# Public HTTPS address assigned by the host, e.g. https://your-app.example
WEBAPP_URL=

# Crypto Pay → My Apps → your app → More → Merchant API
CRYPTO_PAY_TOKEN=

# A long random secret for browser access to /admin
ADMIN_PANEL_TOKEN=

# Optional settings
SUPPORT_USERNAME=DitzzmBack
PRODUCTS_CHANNEL_CHAT_ID=@Ditzzm1337
CRYPTO_PAY_FEE_PERCENT=3
